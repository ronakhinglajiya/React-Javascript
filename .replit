run = "npm run dev"
modules = ["nodejs-20"]
hidden = [".config", "package-lock.json"]
entrypoint = "index.html"

[nix]
channel = "stable-24_05"
packages = ["run"]

[unitTest]
language = "nodejs"

[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 3003

[[ports]]
localPort = 3001
externalPort = 4200

[[ports]]
localPort = 3002
externalPort = 5000

[[ports]]
localPort = 3003
externalPort = 5173

[[ports]]
localPort = 3004
externalPort = 6000

[[ports]]
localPort = 3005
externalPort = 6800

[[ports]]
localPort = 3006
externalPort = 8000

[[ports]]
localPort = 3007
externalPort = 8008

[[ports]]
localPort = 3008
externalPort = 8080

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5002
externalPort = 3001

[[ports]]
localPort = 5003
externalPort = 3002

[[ports]]
localPort = 5004
externalPort = 8081

[[ports]]
localPort = 5005
externalPort = 8099

[[ports]]
localPort = 5006
externalPort = 9000

[[ports]]
localPort = 5173

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
